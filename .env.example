# =============================================================================
# SCINSMEDIA — Production & Environment Configuration Template
# For GoDaddy Node.js Hosting & cPanel MySQL Integration
# =============================================================================

# Server Environment & Port (Assigned dynamically by GoDaddy Phusion Passenger)
NODE_ENV=production
PORT=3000

# Application Public Base URL
APP_URL="https://yourdomain.com"

# =============================================================================
# 1. GODADDY cPANEL MySQL DATABASE CONFIGURATION
# =============================================================================
# In cPanel MySQL Databases:
# 1. Create a database: e.g., "username_scinsmedia"
# 2. Create a user: e.g., "username_dbadmin" with strong password
# 3. Add user to database and grant ALL PRIVILEGES
# 4. Import "database/schema.sql" via phpMyAdmin
#
# Note: For GoDaddy cPanel internal hosting, DB_HOST is usually "localhost" or "127.0.0.1"
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="cpaneluser_dbuser"
DB_PASSWORD="your_strong_mysql_password"
DB_NAME="cpaneluser_scinsmedia"
DB_SSL="false"

# =============================================================================
# 2. ADMINISTRATIVE SECURITY & JWT AUTHENTICATION
# =============================================================================
# Strong secret key for signing admin authentication tokens
JWT_SECRET="generate_a_very_long_random_jwt_secret_token_here_64_chars"

# Administrative Portal Initial Credentials
ADMIN_EMAIL="admin@scinsmedia.com"
ADMIN_PASSWORD_HASH=""

# =============================================================================
# 3. STRIPE PAYMENT GATEWAY CONFIGURATION
# =============================================================================
# Secret Key used server-side for payment intents (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=""

# Publishable Key used by client-side browser Stripe Elements (pk_live_... or pk_test_...)
VITE_STRIPE_PUBLISHABLE_KEY=""

# Stripe Webhook Signing Secret (Optional, for async fulfillment)
STRIPE_WEBHOOK_SECRET=""

# =============================================================================
# 4. EXTERNAL AI & CLOUD SERVICES (Optional)
# =============================================================================
GEMINI_API_KEY=""
