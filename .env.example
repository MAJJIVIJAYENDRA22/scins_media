# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GoDaddy Node.js & MySQL Database Configuration
NODE_ENV=production
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=scinsmedia_db
DB_USER=scinsmedia_user
DB_PASSWORD=your_secure_mysql_password

# Authentication & Security
JWT_SECRET=scinsmedia_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# Email / SMTP Configuration
SMTP_HOST=smtp.godaddy.com
SMTP_PORT=587
SMTP_USER=notifications@scinsmedia.com
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="Scinsmedia Secretariat <secretariat@scinsmedia.com>"
FRONTEND_URL=https://scinsmedia.com

