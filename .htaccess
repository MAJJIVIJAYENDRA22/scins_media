# =============================================================================
# SCINSMEDIA — GoDaddy cPanel Apache & Phusion Passenger Configuration
# =============================================================================

# Enable URL Rewriting
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ensure HTTPS in production (handles direct SSL and upstream reverse proxies/Cloudflare)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Phusion Passenger configuration for GoDaddy cPanel Node.js Selector
<IfModule mod_passenger.c>
  PassengerAppType node
  PassengerStartupFile app.js
  PassengerAppRoot .
</IfModule>

# Prevent directory listings
Options -Indexes
